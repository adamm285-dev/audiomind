# ==============================================================================
# Antigravity Voice Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local workstation or server setup.

# ------------------------------------------------------------------------------
# 1. Cloud Relay Broker (relay/)
# ------------------------------------------------------------------------------
# Shared authentication secret between Android companion, Desktop HUD, and Relay.
# Mandatory: The relay server will fail to start if RELAY_AUTH_SECRET is missing or < 32 characters.
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
RELAY_AUTH_SECRET=example_relay_secret_key_minimum_32_characters_long_placeholder

# Database connection string (SQLite by default; supports PostgreSQL, MySQL)
RELAY_DATABASE_URL=sqlite:///./relay.db

# ------------------------------------------------------------------------------
# 2. Desktop Voice Harness (desktop/)
# ------------------------------------------------------------------------------
# Remote dispatch listener is disabled by default.
# To enable remote polling, provide a secure HTTPS endpoint (or localhost/127.0.0.1 for local dev):
# REMOTE_DISPATCH_API_URL=https://relay.yourdomain.com
# For local development with relay running on port 8000:
REMOTE_DISPATCH_API_URL=http://127.0.0.1:8000

# Desktop session secret key for local HMAC token authentication with relay.
# Must match RELAY_AUTH_SECRET configured on the relay broker.
AUTH_SECRET_KEY=example_relay_secret_key_minimum_32_characters_long_placeholder

# Optional: Path to the Antigravity CLI executable (agy).
# If unset, the desktop daemon resolves agy from PATH via shutil.which("agy").
# Windows example: AGY_PATH=C:\Tools\agy\bin\agy.exe
# POSIX example:   AGY_PATH=/usr/local/bin/agy
# AGY_PATH=

# Preferred default neural voice for desktop read-aloud (ava, emma, andrew, brian)
DEFAULT_TTS_VOICE=ava
